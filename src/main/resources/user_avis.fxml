<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<StackPane xmlns="http://javafx.com/javafx/17" 
           xmlns:fx="http://javafx.com/fxml/1" 
           fx:controller="controllers.UserAvisController">
   <BorderPane prefHeight="600.0" prefWidth="900.0" 
               styleClass="page"
               stylesheets="@style.css">
      
      <!-- Top Bar -->
      <top>
         <VBox>
            <HBox styleClass="topBar" alignment="CENTER_LEFT" spacing="15">
               <Button text="← Retour" styleClass="btnOutline" onAction="#retourMenu" />
                <Label text="⭐  AVIS DES VOYAGEURS" styleClass="pageTitle"
                       style="-fx-text-fill: #c9a24a; -fx-font-size: 20px; -fx-font-weight: 900;"/>
               <Region HBox.hgrow="ALWAYS" />
               <Button fx:id="btnAdd" text="+ Donner un avis" styleClass="btnGold" onAction="#ajouterAvis" />
            </HBox>
         </VBox>
      </top>
      
      <!-- Center Content -->
      <center>
         <VBox styleClass="pageContent" spacing="20">
            
             <!-- Barre de recherche et filtres -->
             <HBox spacing="15" alignment="CENTER_LEFT" styleClass="card">
                
                <!-- Champ de recherche -->
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                   <Label text="Rechercher :" styleClass="metaText" />
                   <TextField fx:id="txtRecherche" 
                              promptText="Rechercher par commentaire..." 
                              prefWidth="300" onKeyReleased="#appliquerFiltres" />
                </VBox>
                
                <!-- Filtre par note -->
                <VBox spacing="5">
                   <Label text="Note :" styleClass="metaText" />
                   <ComboBox fx:id="comboNote" prefWidth="120" promptText="Toutes" onAction="#appliquerFiltres" />
                </VBox>
                
                <!-- Bouton rechercher -->
                <Button text="🔍" 
                        styleClass="btnGold" 
                        onAction="#appliquerFiltres" />
                
                <!-- Bouton réinitialiser -->
                <Button text="↻" 
                        styleClass="btnOutline" 
                        onAction="#reinitialiser" />
                
             </HBox>
             
             <!-- Table -->
            <TableView fx:id="tableAvis" styleClass="table-view" VBox.vgrow="ALWAYS"
                       style="-fx-background-color: white;
                              -fx-background-radius: 16;
                              -fx-border-radius: 16;
                              -fx-border-color: #e6ddd0;
                              -fx-border-width: 1.5;
                              -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 12, 0, 4, 4);">
               <columns>
                  <TableColumn fx:id="colNote"        text="⭐ Note /5"       prefWidth="100"
                               style="-fx-alignment: CENTER;"/>
                  <TableColumn fx:id="colCommentaire" text="Commentaire"       prefWidth="350"/>
                   <TableColumn fx:id="colReponse"     text="Réponse Admin"     prefWidth="230"/>
                   <TableColumn fx:id="colDateReponse" text="Date réponse"      prefWidth="130"/>
                   <TableColumn fx:id="colActions"     text="Actions"           prefWidth="120"/>
               </columns>
            </TableView>
            
         </VBox>
      </center>
   </BorderPane>

   <!-- Bouton chatbot flottant -->
   <Button text="🤖 Assistant" 
           styleClass="btnGold"
           prefWidth="140"
           prefHeight="50"
           style="-fx-font-size: 16px; -fx-font-weight: 900; -fx-background-radius: 25; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 10, 0, 0, 5);"
           onAction="#ouvrirChatbot"
           StackPane.alignment="BOTTOM_RIGHT">
      <StackPane.margin>
         <Insets bottom="20" left="20" right="20" top="20" />
      </StackPane.margin>
   </Button>
</StackPane>
