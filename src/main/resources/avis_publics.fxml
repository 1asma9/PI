<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane prefHeight="700.0" prefWidth="1000.0"
            stylesheets="@style.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.AvisPublicsController">

    <top>
        <VBox style="-fx-background-color: linear-gradient(to right, #0f2a2a, #1a3a3a); -fx-padding: 28 32;">
            <Label text="⭐ Avis des Voyageurs"
                   style="-fx-text-fill:white; -fx-font-size:26px; -fx-font-weight:900;"/>
            <Label text="Découvrez les expériences de notre communauté"
                   style="-fx-text-fill:rgba(255,255,255,0.7); -fx-font-size:13px; -fx-padding:4 0 0 0;"/>

            <!-- Filtres -->
            <HBox spacing="12" alignment="CENTER_LEFT" style="-fx-padding:16 0 0 0;">
                <TextField fx:id="txtRecherche"
                           promptText="🔍 Rechercher un avis..."
                           style="-fx-background-color:rgba(255,255,255,0.15); -fx-text-fill:white; -fx-prompt-text-fill:rgba(255,255,255,0.5); -fx-background-radius:20; -fx-padding:8 16; -fx-font-size:13px;"
                           prefWidth="280"
                           onKeyReleased="#filtrer"/>
                <ComboBox fx:id="comboNote"
                          promptText="Toutes les notes"
                          style="-fx-background-color:rgba(255,255,255,0.15); -fx-background-radius:20;"
                          prefWidth="160"
                          onAction="#filtrer"/>
                <Button text="↻ Réinitialiser" onAction="#reinitialiser"
                        style="-fx-background-color:rgba(255,255,255,0.15); -fx-text-fill:white; -fx-background-radius:20; -fx-padding:8 16; -fx-cursor:hand;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblCount" text="0 avis"
                       style="-fx-text-fill:rgba(255,255,255,0.7); -fx-font-size:13px; -fx-font-weight:700;"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox style="-fx-background-color:#f8f4ef; -fx-padding:20 32;">

            <!-- Liste des posts -->
            <ScrollPane fx:id="scrollPane" fitToWidth="true" VBox.vgrow="ALWAYS"
                        style="-fx-background-color:transparent; -fx-background:transparent; -fx-border-color:transparent;">
                <VBox fx:id="postsContainer" spacing="16">
                    <!-- Les cards avis sont générées dynamiquement -->
                </VBox>
            </ScrollPane>

            <!-- Pagination -->
            <HBox alignment="CENTER" spacing="8" style="-fx-padding:16 0 0 0;">
                <Button fx:id="btnPrev" text="‹ Précédent" onAction="#pagePrecedente"
                        style="-fx-background-color:#0f2a2a; -fx-text-fill:white; -fx-background-radius:20; -fx-padding:9 20; -fx-font-weight:700; -fx-cursor:hand;"/>
                <Label fx:id="lblPage" text="Page 1 / 1"
                       style="-fx-font-size:13px; -fx-font-weight:700; -fx-text-fill:#6a7a73; -fx-padding:0 12;"/>
                <Button fx:id="btnNext" text="Suivant ›" onAction="#pageSuivante"
                        style="-fx-background-color:#0f2a2a; -fx-text-fill:white; -fx-background-radius:20; -fx-padding:9 20; -fx-font-weight:700; -fx-cursor:hand;"/>
            </HBox>
        </VBox>
    </center>

</BorderPane>
