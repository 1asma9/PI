<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="0"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="hebergement.controllers.HebergementClientController"
      style="-fx-background-color: #f5f5f5;">

    <!-- Barre filtres -->
    <VBox style="-fx-background-color: #f0f0f0;
                 -fx-padding: 20 40 20 40;
                 -fx-border-color: #e0e0e0;
                 -fx-border-width: 0 0 1 0;">

        <!-- Ligne 1 -->
        <HBox spacing="16" alignment="CENTER_LEFT">
            <VBox spacing="4">
                <Label text="Rechercher"
                       style="-fx-font-size: 12px; -fx-text-fill: #555;"/>
                <TextField fx:id="tfSearch"
                           promptText="Description..."
                           prefWidth="200"
                           style="-fx-background-color: white;
                                  -fx-border-color: #ccc;
                                  -fx-border-radius: 4;
                                  -fx-background-radius: 4;
                                  -fx-padding: 8 12;
                                  -fx-font-size: 13px;"/>
            </VBox>

            <VBox spacing="4">
                <Label text="Type"
                       style="-fx-font-size: 12px; -fx-text-fill: #555;"/>
                <ComboBox fx:id="cbType"
                          prefWidth="160"
                          style="-fx-background-color: white;
                                 -fx-border-color: #ccc;
                                 -fx-border-radius: 4;
                                 -fx-background-radius: 4;
                                 -fx-font-size: 13px;"/>
            </VBox>

            <VBox spacing="4">
                <Label text="Prix min (TND)"
                       style="-fx-font-size: 12px; -fx-text-fill: #555;"/>
                <TextField fx:id="tfPrixMin"
                           promptText="0"
                           prefWidth="120"
                           style="-fx-background-color: white;
                                  -fx-border-color: #ccc;
                                  -fx-border-radius: 4;
                                  -fx-background-radius: 4;
                                  -fx-padding: 8 12;
                                  -fx-font-size: 13px;"/>
            </VBox>

            <VBox spacing="4">
                <Label text="Prix max (TND)"
                       style="-fx-font-size: 12px; -fx-text-fill: #555;"/>
                <TextField fx:id="tfPrixMax"
                           promptText="9999"
                           prefWidth="120"
                           style="-fx-background-color: white;
                                  -fx-border-color: #ccc;
                                  -fx-border-radius: 4;
                                  -fx-background-radius: 4;
                                  -fx-padding: 8 12;
                                  -fx-font-size: 13px;"/>
            </VBox>

            <VBox spacing="4">
                <Label text="Trier par"
                       style="-fx-font-size: 12px; -fx-text-fill: #555;"/>
                <ComboBox fx:id="cbTri"
                          prefWidth="150"
                          style="-fx-background-color: white;
                                 -fx-border-color: #ccc;
                                 -fx-border-radius: 4;
                                 -fx-background-radius: 4;
                                 -fx-font-size: 13px;"/>
            </VBox>

            <VBox spacing="4">
                <Label text=" " style="-fx-font-size: 12px;"/>
                <Button text="🔍"
                        onAction="#filterData"
                        style="-fx-background-color: #e03030;
                               -fx-text-fill: white;
                               -fx-font-size: 14px;
                               -fx-background-radius: 6;
                               -fx-padding: 8 16;
                               -fx-cursor: hand;"/>
            </VBox>
        </HBox>

        <!-- Ligne 2 : Dates -->
        <HBox spacing="16" alignment="CENTER_LEFT"
              style="-fx-padding: 12 0 0 0;">
            <VBox spacing="4">
                <Label text="Disponible du"
                       style="-fx-font-size: 12px; -fx-text-fill: #555;"/>
                <DatePicker fx:id="dpDebut"
                            prefWidth="200"
                            style="-fx-background-color: white;
                                   -fx-border-color: #ccc;
                                   -fx-border-radius: 4;
                                   -fx-background-radius: 4;
                                   -fx-font-size: 13px;"/>
            </VBox>
            <VBox spacing="4">
                <Label text="Au"
                       style="-fx-font-size: 12px; -fx-text-fill: #555;"/>
                <DatePicker fx:id="dpFin"
                            prefWidth="200"
                            style="-fx-background-color: white;
                                   -fx-border-color: #ccc;
                                   -fx-border-radius: 4;
                                   -fx-background-radius: 4;
                                   -fx-font-size: 13px;"/>
            </VBox>
        </HBox>
    </VBox>

    <!-- Grille de cards -->
    <ScrollPane fitToWidth="true"
                VBox.vgrow="ALWAYS"
                style="-fx-background: #f5f5f5;
                       -fx-background-color: #f5f5f5;">
        <content>
            <FlowPane fx:id="flowPane"
                      hgap="24" vgap="24"
                      style="-fx-padding: 30 40;
                             -fx-background-color: #f5f5f5;"
                      prefWrapLength="1100"/>
        </content>
    </ScrollPane>

</VBox>