<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="0"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="hebergement.controllers.GestionHebergementController"
      style="-fx-background-color: #0d1117; -fx-padding: 24;">

    <!-- Titre -->
    <Label text="Gestion des Hébergements"
           style="-fx-font-size: 26px;
                  -fx-font-weight: 700;
                  -fx-text-fill: white;
                  -fx-font-family: 'Segoe UI';
                  -fx-padding: 0 0 20 0;"/>

    <!-- Card principale -->
    <VBox VBox.vgrow="ALWAYS"
          style="-fx-background-color: #131a2a;
                 -fx-background-radius: 16;
                 -fx-padding: 20;">

        <!-- Filtres -->
        <HBox spacing="10" alignment="CENTER_LEFT"
              style="-fx-padding: 0 0 16 0;">

            <TextField fx:id="tfSearch"
                       promptText="Rechercher (description, type)..."
                       prefWidth="280"
                       style="-fx-background-color: #1a2238;
                              -fx-border-color: #2a3558;
                              -fx-border-radius: 10;
                              -fx-background-radius: 10;
                              -fx-text-fill: #cdd5e0;
                              -fx-prompt-text-fill: #5a6a8a;
                              -fx-padding: 9 14;
                              -fx-font-size: 13px;"/>

            <ComboBox fx:id="cbType"
                      promptText="Type"
                      prefWidth="150"
                      style="-fx-background-color: #1a2238;
                             -fx-border-color: #2a3558;
                             -fx-border-radius: 10;
                             -fx-background-radius: 10;
                             -fx-font-size: 13px;"/>

            <ComboBox fx:id="cbTri"
                      prefWidth="130"
                      style="-fx-background-color: #1a2238;
                             -fx-border-color: #2a3558;
                             -fx-border-radius: 10;
                             -fx-background-radius: 10;
                             -fx-font-size: 13px;"/>

            <ComboBox fx:id="cbOrdre"
                      prefWidth="130"
                      style="-fx-background-color: #1a2238;
                             -fx-border-color: #2a3558;
                             -fx-border-radius: 10;
                             -fx-background-radius: 10;
                             -fx-font-size: 13px;"/>

            <Button text="🔍 Filtrer"
                    onAction="#filterTable"
                    style="-fx-background-color: #6B48FF;
                           -fx-text-fill: white;
                           -fx-font-weight: 700;
                           -fx-font-size: 13px;
                           -fx-background-radius: 20;
                           -fx-padding: 8 20;
                           -fx-cursor: hand;"/>

            <Button text="✕ Reset"
                    onAction="#resetFilters"
                    style="-fx-background-color: transparent;
                           -fx-border-color: #5a6a8a;
                           -fx-border-radius: 20;
                           -fx-background-radius: 20;
                           -fx-text-fill: #cdd5e0;
                           -fx-font-size: 13px;
                           -fx-padding: 8 16;
                           -fx-cursor: hand;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label fx:id="lblTotal"
                   text="0 résultat"
                   style="-fx-font-size: 13px; -fx-text-fill: #6a7a9a;"/>
        </HBox>

        <!-- Header tableau avec boutons -->
        <HBox alignment="CENTER_LEFT" spacing="10"
              style="-fx-padding: 0 0 12 0;">

            <Label text="Liste des Hébergements"
                   style="-fx-font-size: 15px;
                          -fx-font-weight: 700;
                          -fx-text-fill: #8a9bbf;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="+ Ajouter"
                    onAction="#openAdd"
                    style="-fx-background-color: #FF8C00;
                           -fx-text-fill: white;
                           -fx-font-weight: 700;
                           -fx-font-size: 13px;
                           -fx-background-radius: 8;
                           -fx-padding: 8 18;
                           -fx-cursor: hand;"/>

            <Button text="+ Chambre"
                    onAction="#openAddChambre"
                    style="-fx-background-color: #1e3a2e;
                           -fx-text-fill: #4ade80;
                           -fx-font-weight: 700;
                           -fx-font-size: 13px;
                           -fx-background-radius: 8;
                           -fx-padding: 8 18;
                           -fx-cursor: hand;"/>

            <Button text="+ Type"
                    onAction="#openAddType"
                    style="-fx-background-color: #2e2050;
                           -fx-text-fill: #a78bfa;
                           -fx-font-weight: 700;
                           -fx-font-size: 13px;
                           -fx-background-radius: 8;
                           -fx-padding: 8 18;
                           -fx-cursor: hand;"/>
        </HBox>

        <!-- TableView -->
        <TableView fx:id="tableView"
                   VBox.vgrow="ALWAYS"
                   style="-fx-background-color: #131a2a;
                          -fx-border-color: #1e2a40;
                          -fx-border-radius: 10;
                          -fx-background-radius: 10;
                          -fx-table-cell-border-color: #1e2a40;">
            <columns>
                <TableColumn fx:id="colId"
                             text="ID"
                             prefWidth="65"
                             style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="colImage"
                             text="Image"
                             prefWidth="90"
                             style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="colDescription"
                             text="Description"
                             prefWidth="200"/>
                <TableColumn fx:id="colPrix"
                             text="Prix"
                             prefWidth="110"
                             style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="colType"
                             text="Type"
                             prefWidth="120"
                             style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="colChambres"
                             text="Chambres"
                             prefWidth="100"
                             style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="colActions"
                             text="Actions"
                             prefWidth="280"
                             style="-fx-alignment: CENTER;"/>
            </columns>
            <placeholder>
                <Label text="Aucun hébergement trouvé."
                       style="-fx-text-fill: #5a6a8a; -fx-font-size: 13px;"/>
            </placeholder>
        </TableView>

    </VBox>

    <!-- Boutons bas -->
    <HBox alignment="CENTER" spacing="14"
          style="-fx-padding: 22 0 0 0;">

        <Button text="Ajouter"
                onAction="#openAdd"
                style="-fx-background-color: #6B48FF;
                       -fx-text-fill: white;
                       -fx-font-weight: 700;
                       -fx-font-size: 14px;
                       -fx-background-radius: 20;
                       -fx-padding: 12 30;
                       -fx-cursor: hand;"/>

        <Button text="Modifier"
                onAction="#openEdit"
                style="-fx-background-color: #FF8C00;
                       -fx-text-fill: white;
                       -fx-font-weight: 700;
                       -fx-font-size: 14px;
                       -fx-background-radius: 20;
                       -fx-padding: 12 30;
                       -fx-cursor: hand;"/>

        <Button text="Supprimer"
                onAction="#deleteSelected"
                style="-fx-background-color: #FF3B5C;
                       -fx-text-fill: white;
                       -fx-font-weight: 700;
                       -fx-font-size: 14px;
                       -fx-background-radius: 20;
                       -fx-padding: 12 30;
                       -fx-cursor: hand;"/>

        <Button text="📊 Statistiques"
                onAction="#openStats"
                style="-fx-background-color: transparent;
                       -fx-border-color: #5a6a8a;
                       -fx-border-radius: 20;
                       -fx-background-radius: 20;
                       -fx-text-fill: #cdd5e0;
                       -fx-font-weight: 600;
                       -fx-font-size: 14px;
                       -fx-padding: 11 22;
                       -fx-cursor: hand;"/>
    </HBox>

</VBox>