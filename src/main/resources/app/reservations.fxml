<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="0"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="hebergement.controllers.ReservationsAdminController"
      style="-fx-background-color: #0d1117; -fx-padding: 24;">

    <!-- Titre -->
    <Label text="Gérer les Réservations (Admin)"
           style="-fx-font-size: 26px;
                  -fx-font-weight: 700;
                  -fx-text-fill: white;
                  -fx-font-family: 'Segoe UI';
                  -fx-padding: 0 0 20 0;"/>

    <!-- Card principale -->
    <VBox VBox.vgrow="ALWAYS"
          style="-fx-background-color: #131a2a;
                 -fx-background-radius: 16;
                 -fx-padding: 20;">

        <!-- Filtres -->
        <HBox spacing="10" alignment="CENTER_LEFT"
              style="-fx-padding: 0 0 16 0;">

            <ComboBox fx:id="cbHebergementFilter"
                      promptText="Filtrer par hébergement"
                      prefWidth="280"
                      style="-fx-background-color: #1a2238;
                             -fx-border-color: #2a3558;
                             -fx-border-radius: 10;
                             -fx-background-radius: 10;
                             -fx-prompt-text-fill: #5a6a8a;
                             -fx-font-size: 13px;"/>

            <Button text="Filtrer"
                    onAction="#filter"
                    style="-fx-background-color: #6B48FF;
                           -fx-text-fill: white;
                           -fx-font-weight: 700;
                           -fx-font-size: 13px;
                           -fx-background-radius: 20;
                           -fx-padding: 8 22;
                           -fx-cursor: hand;"/>

            <Button text="Tout afficher"
                    onAction="#loadAll"
                    style="-fx-background-color: transparent;
                           -fx-border-color: #5a6a8a;
                           -fx-border-radius: 20;
                           -fx-background-radius: 20;
                           -fx-text-fill: #cdd5e0;
                           -fx-font-size: 13px;
                           -fx-padding: 8 18;
                           -fx-cursor: hand;"/>

            <Button text="Export Excel"
                    onAction="#exportResExcel"
                    style="-fx-background-color: transparent;
                           -fx-border-color: #5a6a8a;
                           -fx-border-radius: 20;
                           -fx-background-radius: 20;
                           -fx-text-fill: #cdd5e0;
                           -fx-font-size: 13px;
                           -fx-padding: 8 18;
                           -fx-cursor: hand;"/>

            <Button text="Export PDF"
                    onAction="#exportResPdf"
                    style="-fx-background-color: #1a2238;
                           -fx-border-color: #5a6a8a;
                           -fx-border-radius: 20;
                           -fx-background-radius: 20;
                           -fx-text-fill: #cdd5e0;
                           -fx-font-size: 13px;
                           -fx-padding: 8 18;
                           -fx-cursor: hand;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label fx:id="lblInfo"
                   text="Total: 0"
                   style="-fx-font-size: 13px;
                          -fx-text-fill: #6a7a9a;"/>
        </HBox>

        <!-- TableView -->
        <TableView fx:id="tableRes"
                   VBox.vgrow="ALWAYS"
                   prefHeight="520"
                   style="-fx-background-color: #131a2a;
                          -fx-border-color: #1e2a40;
                          -fx-border-radius: 10;
                          -fx-background-radius: 10;
                          -fx-table-cell-border-color: #1e2a40;">
            <columns>
                <TableColumn fx:id="idCol"
                             text="ID"
                             prefWidth="70"
                             style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="hebCol"
                             text="Hébergement"
                             prefWidth="140"
                             style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="clientCol"
                             text="Client"
                             prefWidth="170"/>
                <TableColumn fx:id="datesCol"
                             text="Dates"
                             prefWidth="210"/>
                <TableColumn fx:id="totalCol"
                             text="Total"
                             prefWidth="100"
                             style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="statutCol"
                             text="Statut"
                             prefWidth="120"
                             style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="actionsCol"
                             text="Actions"
                             prefWidth="230"
                             style="-fx-alignment: CENTER;"/>
            </columns>
            <placeholder>
                <Label text="Aucune réservation trouvée."
                       style="-fx-text-fill: #5a6a8a; -fx-font-size: 13px;"/>
            </placeholder>
        </TableView>

    </VBox>

    <!-- Boutons bas -->
    <HBox alignment="CENTER" spacing="14"
          style="-fx-padding: 22 0 0 0;">

        <Button text="Ajouter"
                onAction="#openAdd"
                style="-fx-background-color: #6B48FF;
                       -fx-text-fill: white;
                       -fx-font-weight: 700;
                       -fx-font-size: 14px;
                       -fx-background-radius: 20;
                       -fx-padding: 12 30;
                       -fx-cursor: hand;"/>

        <Button text="Modifier"
                onAction="#openEdit"
                style="-fx-background-color: #FF8C00;
                       -fx-text-fill: white;
                       -fx-font-weight: 700;
                       -fx-font-size: 14px;
                       -fx-background-radius: 20;
                       -fx-padding: 12 30;
                       -fx-cursor: hand;"/>

        <Button text="Supprimer"
                onAction="#deleteSelected"
                style="-fx-background-color: #FF3B5C;
                       -fx-text-fill: white;
                       -fx-font-weight: 700;
                       -fx-font-size: 14px;
                       -fx-background-radius: 20;
                       -fx-padding: 12 30;
                       -fx-cursor: hand;"/>

        <Button text="📊 Statistiques"
                onAction="#openStats"
                style="-fx-background-color: transparent;
                       -fx-border-color: #5a6a8a;
                       -fx-border-radius: 20;
                       -fx-background-radius: 20;
                       -fx-text-fill: #cdd5e0;
                       -fx-font-weight: 600;
                       -fx-font-size: 14px;
                       -fx-padding: 11 22;
                       -fx-cursor: hand;"/>
    </HBox>

</VBox>