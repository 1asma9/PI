<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.web.WebView?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<ScrollPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="hebergement.controllers.HebergementDetailController"
            fitToWidth="true"
            hbarPolicy="NEVER"
            style="-fx-background: #f9f9f9; -fx-background-color: #f9f9f9;">
    <content>
        <VBox spacing="0" style="-fx-background-color: #f9f9f9;">

            <!-- HERO BANNER -->
            <StackPane fx:id="heroBanner"
                       prefHeight="220"
                       style="-fx-background-color: #2c3e50;">
                <VBox alignment="CENTER_LEFT" spacing="8"
                      style="-fx-padding: 0 0 0 40;">
                    <Label fx:id="lblBreadcrumb"
                           text="Hébergements / Détail"
                           style="-fx-text-fill: rgba(255,255,255,0.7);
                                  -fx-font-size: 13px;"/>
                    <Label fx:id="lblHeroType"
                           text="Hébergement"
                           style="-fx-text-fill: white;
                                  -fx-font-size: 28px;
                                  -fx-font-weight: 800;
                                  -fx-font-family: 'Segoe UI';"/>
                    <Label fx:id="lblHeroPrix"
                           text="À partir de 0 TND / nuit"
                           style="-fx-text-fill: rgba(255,255,255,0.9);
                                  -fx-font-size: 16px;"/>
                </VBox>
            </StackPane>

            <!-- CONTENU PRINCIPAL -->
            <HBox spacing="28"
                  style="-fx-padding: 30 40 40 40;
                         -fx-background-color: #f9f9f9;">

                <!-- ===== COLONNE GAUCHE ===== -->
                <VBox spacing="24" HBox.hgrow="ALWAYS">

                    <!-- Image principale -->
                    <StackPane style="-fx-background-color: #eee;
                                      -fx-background-radius: 12;">
                        <ImageView fx:id="imgPrincipal"
                                   fitWidth="680"
                                   fitHeight="340"
                                   preserveRatio="false"
                                   smooth="true"
                                   style="-fx-background-radius: 12;"/>
                    </StackPane>

                    <!-- Infos hébergement -->
                    <VBox spacing="8"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 10;
                                 -fx-border-radius: 10;
                                 -fx-border-color: #eee;
                                 -fx-border-width: 1;
                                 -fx-padding: 20;">
                        <Label fx:id="lblTypeBadge"
                               text=""
                               style="-fx-background-color: #fde8e8;
                                      -fx-text-fill: #c0392b;
                                      -fx-font-size: 12px;
                                      -fx-font-weight: 700;
                                      -fx-background-radius: 6;
                                      -fx-padding: 4 12;"/>
                        <Label fx:id="lblDescription"
                               text=""
                               style="-fx-font-size: 14px;
                                      -fx-text-fill: #444;
                                      -fx-font-family: 'Segoe UI';"
                               wrapText="true"/>
                        <Label fx:id="lblPrixInfo"
                               text=""
                               style="-fx-font-size: 14px;
                                      -fx-text-fill: #555;"/>
                    </VBox>

                    <!-- Chambres -->
                    <VBox spacing="12">
                        <Label text="Chambres disponibles"
                               style="-fx-font-size: 17px;
                                      -fx-font-weight: 700;
                                      -fx-text-fill: #1e293b;"/>
                        <Label text="👆 Cliquez sur une chambre pour la sélectionner"
                               style="-fx-font-size: 13px;
                                      -fx-text-fill: #888;"/>
                        <FlowPane fx:id="chambresPane"
                                  hgap="14" vgap="14"
                                  prefWrapLength="680"/>
                    </VBox>

                    <!-- Carte localisation -->
                    <VBox spacing="10"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 12;
                                 -fx-border-radius: 12;
                                 -fx-border-color: #eee;
                                 -fx-border-width: 1;
                                 -fx-padding: 20;">
                        <Label text="📍 Localisation"
                               style="-fx-font-size: 17px;
                                      -fx-font-weight: 700;
                                      -fx-text-fill: #1e293b;"/>
                        <Label fx:id="lblAdresse"
                               text=""
                               style="-fx-font-size: 13px;
                                      -fx-text-fill: #777;"/>
                        <StackPane prefHeight="280" minHeight="280"
                                   style="-fx-background-radius: 10;
                                          -fx-border-radius: 10;
                                          -fx-border-color: #eee;
                                          -fx-border-width: 1;">
                            <WebView fx:id="mapView"
                                     prefHeight="280"
                                     minHeight="280"/>
                        </StackPane>
                    </VBox>

                </VBox>

                <!-- ===== COLONNE DROITE : FORMULAIRE ===== -->
                <VBox spacing="16" prefWidth="340" minWidth="320">

                    <!-- Infos stats -->
                    <HBox spacing="10">
                        <VBox alignment="CENTER" spacing="4"
                              HBox.hgrow="ALWAYS"
                              style="-fx-background-color: white;
                                     -fx-background-radius: 10;
                                     -fx-border-radius: 10;
                                     -fx-border-color: #eee;
                                     -fx-border-width: 1;
                                     -fx-padding: 14;">
                            <Label fx:id="lblNbChambres" text="0"
                                   style="-fx-font-size: 22px;
                                          -fx-font-weight: 800;
                                          -fx-text-fill: #f75959;"/>
                            <Label text="Chambres"
                                   style="-fx-font-size: 11px;
                                          -fx-text-fill: #888;"/>
                        </VBox>
                        <VBox alignment="CENTER" spacing="4"
                              HBox.hgrow="ALWAYS"
                              style="-fx-background-color: white;
                                     -fx-background-radius: 10;
                                     -fx-border-radius: 10;
                                     -fx-border-color: #eee;
                                     -fx-border-width: 1;
                                     -fx-padding: 14;">
                            <Label fx:id="lblPrixStat" text="0 TND"
                                   style="-fx-font-size: 22px;
                                          -fx-font-weight: 800;
                                          -fx-text-fill: #f75959;"/>
                            <Label text="Prix / nuit"
                                   style="-fx-font-size: 11px;
                                          -fx-text-fill: #888;"/>
                        </VBox>
                    </HBox>

                    <!-- Chambre sélectionnée -->
                    <VBox fx:id="panelChambreSelectionnee"
                          spacing="4"
                          style="-fx-background-color: #f0fdf4;
                                 -fx-border-color: #bbf7d0;
                                 -fx-border-width: 1;
                                 -fx-border-radius: 8;
                                 -fx-background-radius: 8;
                                 -fx-padding: 12;"
                          visible="false" managed="false">
                        <Label text="✅ Chambre sélectionnée :"
                               style="-fx-font-size: 12px;
                                      -fx-font-weight: 700;
                                      -fx-text-fill: #16a34a;"/>
                        <Label fx:id="lblChambreInfo"
                               text=""
                               style="-fx-font-size: 13px;
                                      -fx-text-fill: #374151;
                                      -fx-font-weight: 600;"/>
                        <Label fx:id="lblChambrePrix"
                               text=""
                               style="-fx-font-size: 16px;
                                      -fx-text-fill: #f75959;
                                      -fx-font-weight: 800;"/>
                    </VBox>

                    <!-- Formulaire réservation -->
                    <VBox spacing="12"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 12;
                                 -fx-border-radius: 12;
                                 -fx-border-color: #eee;
                                 -fx-border-width: 1;
                                 -fx-padding: 22;">

                        <Label text="Réserver maintenant"
                               style="-fx-font-size: 17px;
                                      -fx-font-weight: 700;
                                      -fx-text-fill: #f75959;"/>

                        <VBox spacing="4">
                            <Label text="Nom complet *"
                                   style="-fx-font-size: 13px;
                                          -fx-font-weight: 600;
                                          -fx-text-fill: #333;"/>
                            <TextField fx:id="tfNom"
                                       promptText="Votre nom"
                                       style="-fx-background-color: white;
                                              -fx-border-color: #ddd;
                                              -fx-border-radius: 6;
                                              -fx-background-radius: 6;
                                              -fx-padding: 9 12;
                                              -fx-font-size: 13px;"/>
                        </VBox>

                        <VBox spacing="4">
                            <Label text="Téléphone * (8 chiffres)"
                                   style="-fx-font-size: 13px;
                                          -fx-font-weight: 600;
                                          -fx-text-fill: #333;"/>
                            <TextField fx:id="tfTel"
                                       promptText="Ex: 22334455"
                                       style="-fx-background-color: white;
                                              -fx-border-color: #ddd;
                                              -fx-border-radius: 6;
                                              -fx-background-radius: 6;
                                              -fx-padding: 9 12;
                                              -fx-font-size: 13px;"/>
                        </VBox>

                        <VBox spacing="4">
                            <Label text="Email *"
                                   style="-fx-font-size: 13px;
                                          -fx-font-weight: 600;
                                          -fx-text-fill: #333;"/>
                            <TextField fx:id="tfEmail"
                                       promptText="email@exemple.com"
                                       style="-fx-background-color: white;
                                              -fx-border-color: #ddd;
                                              -fx-border-radius: 6;
                                              -fx-background-radius: 6;
                                              -fx-padding: 9 12;
                                              -fx-font-size: 13px;"/>
                        </VBox>

                        <VBox spacing="4">
                            <Label text="Date d'arrivée *"
                                   style="-fx-font-size: 13px;
                                          -fx-font-weight: 600;
                                          -fx-text-fill: #333;"/>
                            <DatePicker fx:id="dpDebut"
                                        maxWidth="Infinity"
                                        style="-fx-font-size: 13px;"/>
                        </VBox>

                        <VBox spacing="4">
                            <Label text="Date de départ *"
                                   style="-fx-font-size: 13px;
                                          -fx-font-weight: 600;
                                          -fx-text-fill: #333;"/>
                            <DatePicker fx:id="dpFin"
                                        maxWidth="Infinity"
                                        style="-fx-font-size: 13px;"/>
                        </VBox>

                        <!-- Prix total -->
                        <VBox fx:id="panelPrixTotal"
                              spacing="2"
                              style="-fx-background-color: #fff3f0;
                                     -fx-border-color: #fecaca;
                                     -fx-border-width: 1;
                                     -fx-border-radius: 8;
                                     -fx-background-radius: 8;
                                     -fx-padding: 12;"
                              visible="false" managed="false">
                            <Label text="Prix estimé :"
                                   style="-fx-font-size: 12px;
                                          -fx-text-fill: #888;"/>
                            <Label fx:id="lblTotal"
                                   text=""
                                   style="-fx-font-size: 20px;
                                          -fx-font-weight: 800;
                                          -fx-text-fill: #f75959;"/>
                        </VBox>

                        <Label fx:id="lblMsg"
                               text=""
                               style="-fx-font-size: 12px;
                                      -fx-text-fill: #f75959;"
                               wrapText="true"/>

                        <Button text="Confirmer la réservation"
                                onAction="#addReservation"
                                maxWidth="Infinity"
                                style="-fx-background-color: #f75959;
                                       -fx-text-fill: white;
                                       -fx-font-weight: 700;
                                       -fx-font-size: 14px;
                                       -fx-background-radius: 6;
                                       -fx-padding: 12 0;
                                       -fx-cursor: hand;"/>
                    </VBox>
                </VBox>
            </HBox>
        </VBox>
    </content>
</ScrollPane>