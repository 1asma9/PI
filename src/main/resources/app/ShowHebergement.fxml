<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.web.WebView?>
<?import javafx.geometry.Insets?>

<VBox spacing="0"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="hebergement.controllers.ShowHebergementController"
      style="-fx-background-color: #0d1117; -fx-padding: 24;">

    <!-- Titre -->
    <Label text="Gérer (Hébergement + Disponibilités)"
           style="-fx-font-size: 26px;
                  -fx-font-weight: 700;
                  -fx-text-fill: white;
                  -fx-font-family: 'Segoe UI';
                  -fx-padding: 0 0 20 0;"/>

    <SplitPane dividerPositions="0.60"
               VBox.vgrow="ALWAYS"
               prefHeight="600"
               style="-fx-background-color: transparent;
                      -fx-border-color: transparent;
                      -fx-padding: 0;">

        <!-- ===== GAUCHE : Hébergements ===== -->
        <VBox spacing="12"
              style="-fx-background-color: #131a2a;
                     -fx-background-radius: 16;
                     -fx-padding: 20;">

            <Label text="Hébergements"
                   style="-fx-font-size: 14px;
                          -fx-font-weight: 700;
                          -fx-text-fill: #8a9bbf;
                          -fx-font-family: 'Segoe UI';"/>

            <!-- Filtres -->
            <HBox spacing="10" alignment="CENTER_LEFT">

                <TextField fx:id="tfSearch"
                           promptText="Rechercher (description, adresse)..."
                           HBox.hgrow="ALWAYS"
                           style="-fx-background-color: #1a2238;
                                  -fx-border-color: #2a3558;
                                  -fx-border-radius: 10;
                                  -fx-background-radius: 10;
                                  -fx-text-fill: #cdd5e0;
                                  -fx-prompt-text-fill: #5a6a8a;
                                  -fx-padding: 8 14;
                                  -fx-font-size: 13px;"/>

                <ComboBox fx:id="cbTypeFilter"
                          promptText="Type"
                          prefWidth="140"
                          style="-fx-background-color: #1a2238;
                                 -fx-border-color: #2a3558;
                                 -fx-border-radius: 10;
                                 -fx-background-radius: 10;
                                 -fx-font-size: 13px;"/>

                <TextField fx:id="tfMinPrix"
                           promptText="Prix min"
                           prefWidth="90"
                           style="-fx-background-color: #1a2238;
                                  -fx-border-color: #2a3558;
                                  -fx-border-radius: 10;
                                  -fx-background-radius: 10;
                                  -fx-text-fill: #cdd5e0;
                                  -fx-prompt-text-fill: #5a6a8a;
                                  -fx-padding: 8 14;
                                  -fx-font-size: 13px;"/>

                <TextField fx:id="tfMaxPrix"
                           promptText="Prix max"
                           prefWidth="90"
                           style="-fx-background-color: #1a2238;
                                  -fx-border-color: #2a3558;
                                  -fx-border-radius: 10;
                                  -fx-background-radius: 10;
                                  -fx-text-fill: #cdd5e0;
                                  -fx-prompt-text-fill: #5a6a8a;
                                  -fx-padding: 8 14;
                                  -fx-font-size: 13px;"/>

                <Button text="Réinitialiser"
                        onAction="#resetFilters"
                        style="-fx-background-color: transparent;
                               -fx-border-color: #5a6a8a;
                               -fx-border-radius: 20;
                               -fx-background-radius: 20;
                               -fx-text-fill: #cdd5e0;
                               -fx-font-size: 12px;
                               -fx-padding: 7 14;
                               -fx-cursor: hand;"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button text="⬇ Export Excel"
                        onAction="#exportHebExcel"
                        style="-fx-background-color: transparent;
                               -fx-border-color: #5a6a8a;
                               -fx-border-radius: 20;
                               -fx-background-radius: 20;
                               -fx-text-fill: #cdd5e0;
                               -fx-font-size: 12px;
                               -fx-padding: 7 14;
                               -fx-cursor: hand;"/>

                <Button text="⬇ Export PDF"
                        onAction="#exportHebPdf"
                        style="-fx-background-color: transparent;
                               -fx-border-color: #5a6a8a;
                               -fx-border-radius: 20;
                               -fx-background-radius: 20;
                               -fx-text-fill: #cdd5e0;
                               -fx-font-size: 12px;
                               -fx-padding: 7 14;
                               -fx-cursor: hand;"/>
            </HBox>

            <!-- TableView Hébergements -->
            <TableView fx:id="tableHeb"
                       VBox.vgrow="ALWAYS"
                       style="-fx-background-color: #131a2a;
                              -fx-border-color: #1e2a40;
                              -fx-border-radius: 10;
                              -fx-background-radius: 10;
                              -fx-table-cell-border-color: #1e2a40;">
                <columns>
                    <TableColumn fx:id="imgCol"
                                 text="Image"
                                 prefWidth="90"
                                 style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="descCol"
                                 text="Description"
                                 prefWidth="220"/>
                    <TableColumn fx:id="adrCol"
                                 text="Adresse"
                                 prefWidth="170"/>
                    <TableColumn fx:id="prixCol"
                                 text="Prix"
                                 prefWidth="100"
                                 style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="actionsCol"
                                 text="Actions"
                                 prefWidth="160"
                                 style="-fx-alignment: CENTER;"/>
                </columns>
                <placeholder>
                    <Label text="Aucun hébergement trouvé."
                           style="-fx-text-fill: #5a6a8a; -fx-font-size: 13px;"/>
                </placeholder>
            </TableView>

            <Label fx:id="lblHebInfo"
                   style="-fx-font-size: 12px; -fx-text-fill: #6a7a9a;"/>

            <!-- ===== BOUTONS BAS (comme Gestion Destinations) ===== -->
            <HBox alignment="CENTER" spacing="14"
                  style="-fx-padding: 10 0 0 0;">

                <Button text="Ajouter"
                        onAction="#openAddHebergement"
                        style="-fx-background-color: #6B48FF;
                               -fx-text-fill: white;
                               -fx-font-weight: 700;
                               -fx-font-size: 14px;
                               -fx-background-radius: 20;
                               -fx-padding: 11 28;
                               -fx-cursor: hand;"/>

                <Button text="Modifier"
                        onAction="#openEditSelected"
                        style="-fx-background-color: #FF8C00;
                               -fx-text-fill: white;
                               -fx-font-weight: 700;
                               -fx-font-size: 14px;
                               -fx-background-radius: 20;
                               -fx-padding: 11 28;
                               -fx-cursor: hand;"/>

                <Button text="Supprimer"
                        onAction="#deleteSelected"
                        style="-fx-background-color: #FF3B5C;
                               -fx-text-fill: white;
                               -fx-font-weight: 700;
                               -fx-font-size: 14px;
                               -fx-background-radius: 20;
                               -fx-padding: 11 28;
                               -fx-cursor: hand;"/>

                <Button text="📊 Statistiques"
                        onAction="#openStats"
                        style="-fx-background-color: transparent;
                               -fx-border-color: #5a6a8a;
                               -fx-border-radius: 20;
                               -fx-background-radius: 20;
                               -fx-text-fill: #cdd5e0;
                               -fx-font-weight: 600;
                               -fx-font-size: 14px;
                               -fx-padding: 10 22;
                               -fx-cursor: hand;"/>
            </HBox>

        </VBox>

        <!-- ===== DROITE : Disponibilités + Localisation ===== -->
        <VBox spacing="14"
              style="-fx-background-color: transparent; -fx-padding: 0 0 0 4;">

            <!-- Disponibilités -->
            <VBox spacing="10"
                  VBox.vgrow="ALWAYS"
                  style="-fx-background-color: #131a2a;
                         -fx-background-radius: 16;
                         -fx-padding: 20;">

                <Label text="Disponibilités"
                       style="-fx-font-size: 14px;
                              -fx-font-weight: 700;
                              -fx-text-fill: #8a9bbf;
                              -fx-font-family: 'Segoe UI';"/>

                <TableView fx:id="tableDispo"
                           VBox.vgrow="ALWAYS"
                           style="-fx-background-color: #131a2a;
                                  -fx-border-color: #1e2a40;
                                  -fx-border-radius: 10;
                                  -fx-background-radius: 10;
                                  -fx-table-cell-border-color: #1e2a40;">
                    <columns>
                        <TableColumn fx:id="dispoIdCol"
                                     text="ID"
                                     prefWidth="55"
                                     style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="debutCol"
                                     text="Début"
                                     prefWidth="110"/>
                        <TableColumn fx:id="finCol"
                                     text="Fin"
                                     prefWidth="110"/>
                        <TableColumn fx:id="disponibleCol"
                                     text="Disponible"
                                     prefWidth="100"
                                     style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="dispoActionsCol"
                                     text="Actions"
                                     prefWidth="160"
                                     style="-fx-alignment: CENTER;"/>
                    </columns>
                    <placeholder>
                        <Label text="Sélectionne un hébergement."
                               style="-fx-text-fill: #5a6a8a; -fx-font-size: 13px;"/>
                    </placeholder>
                </TableView>

                <Label fx:id="lblDispoInfo"
                       style="-fx-font-size: 12px; -fx-text-fill: #6a7a9a;"/>
            </VBox>

            <!-- Localisation -->
            <VBox spacing="10"
                  style="-fx-background-color: #131a2a;
                         -fx-background-radius: 16;
                         -fx-padding: 20;">

                <Label text="Localisation"
                       style="-fx-font-size: 14px;
                              -fx-font-weight: 700;
                              -fx-text-fill: #8a9bbf;
                              -fx-font-family: 'Segoe UI';"/>

                <Label fx:id="lblMapInfo"
                       text="Sélectionne un hébergement pour voir sa position."
                       style="-fx-font-size: 12px; -fx-text-fill: #5a6a8a;"/>

                <StackPane prefHeight="300" minHeight="300"
                           style="-fx-background-radius: 12;
                                  -fx-border-radius: 12;
                                  -fx-border-color: #2a3558;
                                  -fx-border-width: 1;">
                    <WebView fx:id="mapViewHeb"
                             prefHeight="300"
                             minHeight="300"/>
                </StackPane>
            </VBox>

        </VBox>
    </SplitPane>

</VBox>