<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane prefHeight="700.0" prefWidth="1000.0"
            stylesheets="@style.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.MonProfilController">

    <top>
        <VBox style="-fx-background-color: linear-gradient(to right, #0f2a2a, #1a3a3a); -fx-padding: 28 32 32 32;">
            <HBox alignment="CENTER_LEFT" spacing="20">
                <StackPane style="-fx-background-color:#c9a24a; -fx-background-radius:50%; -fx-min-width:60; -fx-min-height:60;">
                    <Label fx:id="lblInitiales" text="RH"
                           style="-fx-text-fill:white; -fx-font-size:22px; -fx-font-weight:900;"/>
                </StackPane>
                <VBox spacing="4">
                    <Label fx:id="lblNomUtilisateur" text="Rayen Hafian"
                           style="-fx-text-fill:white; -fx-font-size:20px; -fx-font-weight:800;"/>
                    <Label fx:id="lblEmailUtilisateur" text="rayenhafian72@gmail.com"
                           style="-fx-text-fill:rgba(255,255,255,0.7); -fx-font-size:13px;"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="← Retour" onAction="#retourMenu"
                        style="-fx-background-color:rgba(255,255,255,0.15); -fx-text-fill:white; -fx-background-radius:8; -fx-padding:8 18; -fx-cursor:hand; -fx-font-weight:700;"/>
            </HBox>

            <!-- Onglets -->
            <HBox spacing="0" style="-fx-padding: 20 0 0 0;">
                <Button fx:id="btnOngletAvis" text="⭐ Mes Avis"
                        onAction="#afficherOngletAvis"
                        style="-fx-background-color:#c9a24a; -fx-text-fill:white; -fx-font-weight:800; -fx-font-size:13px; -fx-padding:10 24; -fx-background-radius:10 10 0 0; -fx-cursor:hand;"/>
                <Button fx:id="btnOngletReclamations" text="📝 Mes Réclamations"
                        onAction="#afficherOngletReclamations"
                        style="-fx-background-color:rgba(255,255,255,0.1); -fx-text-fill:rgba(255,255,255,0.8); -fx-font-weight:700; -fx-font-size:13px; -fx-padding:10 24; -fx-background-radius:10 10 0 0; -fx-cursor:hand;"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <StackPane>
            <!-- ONGLET AVIS -->
            <VBox fx:id="panelAvis" spacing="16"
                  style="-fx-background-color:#f8f4ef; -fx-padding: 24;">

                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="⭐ Mes Avis" style="-fx-font-size:18px; -fx-font-weight:800; -fx-text-fill:#0f2a2a;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="🤖 Assistant IA" onAction="#ouvrirChatbotAvis"
                            style="-fx-background-color:linear-gradient(to right,#667eea,#764ba2); -fx-text-fill:white; -fx-font-weight:700; -fx-background-radius:20; -fx-padding:8 18; -fx-cursor:hand;"/>
                    <Button text="+ Nouvel avis" onAction="#ajouterAvis"
                            style="-fx-background-color:#c9a24a; -fx-text-fill:white; -fx-font-weight:700; -fx-background-radius:20; -fx-padding:8 18; -fx-cursor:hand;"/>
                </HBox>

                <TableView fx:id="tableAvis" VBox.vgrow="ALWAYS"
                           style="-fx-background-color:white; -fx-background-radius:16; -fx-border-radius:16; -fx-border-color:#e6ddd0; -fx-border-width:1.5; -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.06),12,0,0,4);">
                    <columns>
                        <TableColumn fx:id="colAvisNote"        text="⭐ Note"       prefWidth="90"/>
                        <TableColumn fx:id="colAvisCommentaire" text="Commentaire"   prefWidth="320"/>
                        <TableColumn fx:id="colAvisStatut"      text="Statut"        prefWidth="110"/>
                        <TableColumn fx:id="colAvisReponse"     text="Réponse admin" prefWidth="220"/>
                        <TableColumn fx:id="colAvisDate"        text="Date"          prefWidth="120"/>
                        <TableColumn fx:id="colAvisActions"     text="Actions"       prefWidth="130"/>
                    </columns>
                </TableView>

                <!-- Pagination Avis -->
                <HBox alignment="CENTER" spacing="8">
                    <Button fx:id="btnPrevAvis" text="‹" onAction="#pagePrevAvis"
                            style="-fx-background-color:white; -fx-border-color:#c9a24a; -fx-border-width:1.5; -fx-border-radius:8; -fx-background-radius:8; -fx-min-width:34; -fx-min-height:34; -fx-font-weight:900; -fx-cursor:hand;"/>
                    <Label fx:id="lblPageAvis" text="Page 1 / 1"
                           style="-fx-font-size:13px; -fx-font-weight:700; -fx-text-fill:#6a7a73;"/>
                    <Button fx:id="btnNextAvis" text="›" onAction="#pageNextAvis"
                            style="-fx-background-color:white; -fx-border-color:#c9a24a; -fx-border-width:1.5; -fx-border-radius:8; -fx-background-radius:8; -fx-min-width:34; -fx-min-height:34; -fx-font-weight:900; -fx-cursor:hand;"/>
                </HBox>
            </VBox>

            <!-- ONGLET RÉCLAMATIONS -->
            <VBox fx:id="panelReclamations" spacing="16" visible="false" managed="false"
                  style="-fx-background-color:#f8f4ef; -fx-padding: 24;">

                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="📝 Mes Réclamations" style="-fx-font-size:18px; -fx-font-weight:800; -fx-text-fill:#0f2a2a;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="🤖 Assistant IA" onAction="#ouvrirChatbotReclamation"
                            style="-fx-background-color:linear-gradient(to right,#667eea,#764ba2); -fx-text-fill:white; -fx-font-weight:700; -fx-background-radius:20; -fx-padding:8 18; -fx-cursor:hand;"/>
                    <Button text="+ Nouvelle réclamation" onAction="#ajouterReclamation"
                            style="-fx-background-color:#c9a24a; -fx-text-fill:white; -fx-font-weight:700; -fx-background-radius:20; -fx-padding:8 18; -fx-cursor:hand;"/>
                </HBox>

                <TableView fx:id="tableReclamations" VBox.vgrow="ALWAYS"
                           style="-fx-background-color:white; -fx-background-radius:16; -fx-border-radius:16; -fx-border-color:#e6ddd0; -fx-border-width:1.5; -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.06),12,0,0,4);">
                    <columns>
                        <TableColumn fx:id="colReclTitre"       text="Titre"         prefWidth="200"/>
                        <TableColumn fx:id="colReclPriorite"    text="Priorité"      prefWidth="100"/>
                        <TableColumn fx:id="colReclStatut"      text="Statut"        prefWidth="110"/>
                        <TableColumn fx:id="colReclDate"        text="Date"          prefWidth="120"/>
                        <TableColumn fx:id="colReclReponse"     text="Réponse admin" prefWidth="220"/>
                        <TableColumn fx:id="colReclActions"     text="Actions"       prefWidth="130"/>
                    </columns>
                </TableView>

                <!-- Pagination Réclamations -->
                <HBox alignment="CENTER" spacing="8">
                    <Button fx:id="btnPrevRecl" text="‹" onAction="#pagePrevRecl"
                            style="-fx-background-color:white; -fx-border-color:#c9a24a; -fx-border-width:1.5; -fx-border-radius:8; -fx-background-radius:8; -fx-min-width:34; -fx-min-height:34; -fx-font-weight:900; -fx-cursor:hand;"/>
                    <Label fx:id="lblPageRecl" text="Page 1 / 1"
                           style="-fx-font-size:13px; -fx-font-weight:700; -fx-text-fill:#6a7a73;"/>
                    <Button fx:id="btnNextRecl" text="›" onAction="#pageNextRecl"
                            style="-fx-background-color:white; -fx-border-color:#c9a24a; -fx-border-width:1.5; -fx-border-radius:8; -fx-background-radius:8; -fx-min-width:34; -fx-min-height:34; -fx-font-weight:900; -fx-cursor:hand;"/>
                </HBox>
            </VBox>
        </StackPane>
    </center>

</BorderPane>
