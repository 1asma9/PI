<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.*?>

<Pane fx:id="content_area"
      prefHeight="629.0"
      prefWidth="1084.0"
      style="-fx-background-color: #0b1220;"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="edu.connexion3a8.controllers.BlogListController">

    <children>

        <VBox layoutX="30.0" layoutY="25.0" spacing="18.0" prefWidth="1024.0">

            <HBox alignment="CENTER_LEFT" spacing="20">
                <Text text="Liste des articles"
                      fill="#f3f7ff"
                      style="-fx-font-size: 28px; -fx-font-weight: bold;" />

                <Region HBox.hgrow="ALWAYS"/>

                <TextField fx:id="blogSearchInput"
                           prefWidth="280"
                           promptText="Rechercher un article..."
                           style="-fx-background-color: rgba(24,39,66,0.95);
                                  -fx-text-fill: white;
                                  -fx-background-radius: 18;
                                  -fx-border-radius: 18;
                                  -fx-padding: 8 18;" />

                <ComboBox fx:id="sortComboBox"
                          prefWidth="160"
                          promptText="Trier par"
                          style="-fx-background-radius: 18;
                                 -fx-border-radius: 18;
                                 -fx-background-color: rgba(24,39,66,0.95);
                                 -fx-text-fill: white;" />

                <ComboBox fx:id="statusFilterComboBox"
                          prefWidth="170"
                          promptText="Statut"
                          style="-fx-background-radius: 18;
                                 -fx-border-radius: 18;
                                 -fx-background-color: rgba(24,39,66,0.95);
                                 -fx-text-fill: white;" />

                <Button fx:id="addBlogBtn"
                        text="+ Ajouter"
                        onAction="#openAddBlogForm"
                        style="-fx-background-color: #3b82f6;
                               -fx-text-fill: white;
                               -fx-background-radius: 24;
                               -fx-padding: 8 26;
                               -fx-font-weight: bold;" />

            </HBox>

            <HBox spacing="14.0">
                <VBox spacing="4" style="-fx-background-color: rgba(19,31,54,0.95); -fx-padding: 18; -fx-background-radius: 16;" HBox.hgrow="ALWAYS">
                    <Text text="Total articles" style="-fx-fill: rgba(200,210,230,0.9); -fx-font-size: 12;"/>
                    <Text fx:id="totalStatsLabel" text="0" style="-fx-fill: white; -fx-font-size: 22; -fx-font-weight: bold;"/>
                </VBox>
                <VBox spacing="4" style="-fx-background-color: rgba(19,31,54,0.95); -fx-padding: 18; -fx-background-radius: 16;" HBox.hgrow="ALWAYS">
                    <Text text="Articles publiés" style="-fx-fill: rgba(200,210,230,0.9); -fx-font-size: 12;"/>
                    <Text fx:id="publishedStatsLabel" text="0" style="-fx-fill: white; -fx-font-size: 22; -fx-font-weight: bold;"/>
                </VBox>
                <VBox spacing="4" style="-fx-background-color: rgba(19,31,54,0.95); -fx-padding: 18; -fx-background-radius: 16;" HBox.hgrow="ALWAYS">
                    <Text text="Articles en brouillon" style="-fx-fill: rgba(200,210,230,0.9); -fx-font-size: 12;"/>
                    <Text fx:id="draftStatsLabel" text="0" style="-fx-fill: white; -fx-font-size: 22; -fx-font-weight: bold;"/>
                </VBox>
                <VBox spacing="4" style="-fx-background-color: rgba(19,31,54,0.95); -fx-padding: 18; -fx-background-radius: 16;" HBox.hgrow="ALWAYS">
                    <Text text="En attente" style="-fx-fill: rgba(200,210,230,0.9); -fx-font-size: 12;"/>
                    <Text fx:id="viewsStatsLabel" text="0" style="-fx-fill: white; -fx-font-size: 22; -fx-font-weight: bold;"/>
                </VBox>
            </HBox>

            <TableView fx:id="blogTable"
                       prefHeight="520.0"
                       VBox.vgrow="ALWAYS"
                       style="-fx-background-color: transparent; -fx-border-color: transparent;">
                <columns>
                    <TableColumn fx:id="imageColumn" text="IMAGE" prefWidth="110"/>
                    <TableColumn fx:id="titleColumn" text="TITRE" prefWidth="250"/>
                    <TableColumn fx:id="authorColumn" text="AUTEUR" prefWidth="130"/>
                    <TableColumn fx:id="categoryColumn" text="CATÉGORIE" prefWidth="130"/>
                    <TableColumn fx:id="dateColumn" text="DATE" prefWidth="120"/>
                    <TableColumn fx:id="statusColumn" text="STATUT" prefWidth="120"/>
                    <TableColumn fx:id="actionsColumn" text="ACTIONS" prefWidth="180"/>
                </columns>
            </TableView>
        </VBox>

        <!-- ================= ADD / EDIT MODAL ================= -->
        <HBox fx:id="blogFormModal"
              alignment="CENTER"
              prefHeight="700"
              prefWidth="1366"
              style="-fx-background-color: rgba(0,0,0,0.4);"
              visible="false">

            <children>

                <Pane prefHeight="550"
                      prefWidth="600"
                      style="-fx-background-color: #131f36;
                             -fx-background-radius: 20;
                             -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 20, 0, 0, 6);">

                    <children>

                        <!-- Modal Header -->
                        <HBox alignment="CENTER_LEFT"
                              prefHeight="60"
                              prefWidth="600"
                              style="-fx-background-color: #3b82f6;
                                     -fx-background-radius: 20 20 0 0;">

                            <padding>
                                <Insets left="25"/>
                            </padding>

                            <children>

                                <Text fx:id="modalTitle"
                                      text="Ajouter un Blog"
                                      fill="white"
                                      style="-fx-font-size: 20px; -fx-font-weight: bold;" />

                                <Region HBox.hgrow="ALWAYS"/>

                                <Text text="✕"
                                      fill="white"
                                      onMouseClicked="#closeBlogFormModal"
                                      style="-fx-font-size: 20px; -fx-cursor: hand;" />
                            </children>
                        </HBox>

                        <!-- Form Content -->
                        <ScrollPane layoutY="60"
                                    prefHeight="430"
                                    prefWidth="600"
                                    style="-fx-background-color: transparent;">

                            <content>
                                <VBox spacing="15">

                                    <padding>
                                        <Insets top="20" left="30" right="30" bottom="20"/>
                                    </padding>

                                    <!-- Titre -->
                                    <TextField fx:id="titreInput"
                                               promptText="Titre du blog"
                                               style="-fx-background-radius: 10;" />

                                    <!-- Slug -->
                                    <TextField fx:id="slugInput"
                                               promptText="Slug"
                                               style="-fx-background-radius: 10;" />

                                    <!-- Extrait -->
                                    <TextArea fx:id="extraitInput"
                                              promptText="Résumé du blog"
                                              prefHeight="80"
                                              wrapText="true"
                                              style="-fx-background-radius: 10;" />

                                    <!-- Contenu -->
                                    <TextArea fx:id="contenuInput"
                                              promptText="Contenu complet"
                                              prefHeight="150"
                                              wrapText="true"
                                              style="-fx-background-radius: 10;" />

                                    <!-- Image -->
                                    <TextField fx:id="imageCouvertureInput"
                                               promptText="URL de l'image"
                                               style="-fx-background-radius: 10;" />

                                    <!-- Status -->
                                    <CheckBox fx:id="statusCheckbox"
                                              text="Publié" />

                                </VBox>
                            </content>
                        </ScrollPane>

                        <!-- Buttons -->
                        <HBox alignment="CENTER"
                              layoutY="500"
                              prefHeight="50"
                              prefWidth="600"
                              spacing="20">

                            <Button text="Annuler"
                                    onAction="#closeBlogFormModal"
                                    style="-fx-background-color: transparent;
                                           -fx-border-color: #3b82f6;
                                           -fx-border-radius: 20;
                                           -fx-text-fill: #c8d2e6;" />

                            <Button text="Enregistrer"
                                    onAction="#saveBlog"
                                    style="-fx-background-color: #3b82f6;
                                           -fx-text-fill: white;
                                           -fx-background-radius: 20;" />
                        </HBox>

                    </children>
                </Pane>

            </children>
        </HBox>

        <!-- ================= DELETE MODAL ================= -->
        <HBox fx:id="deleteConfirmModal"
              alignment="CENTER"
              prefHeight="700"
              prefWidth="1366"
              style="-fx-background-color: rgba(0,0,0,0.4);"
              visible="false">

            <children>

                <Pane prefHeight="220"
                      prefWidth="400"
                      style="-fx-background-color: #131f36;
                             -fx-background-radius: 20;">

                    <children>

                        <VBox alignment="CENTER"
                              spacing="20"
                              prefHeight="220"
                              prefWidth="400">

                            <Text text="Voulez-vous vraiment supprimer ce blog ?"
                                  wrappingWidth="320"
                                  textAlignment="CENTER"
                                  fill="#c8d2e6"
                                  style="-fx-font-size: 14px;" />

                            <HBox spacing="20">

                                <Button text="Annuler"
                                        onAction="#closeDeleteConfirmModal"
                                        style="-fx-background-color: transparent;
                                               -fx-border-color: #3b82f6;
                                               -fx-border-radius: 20;
                                               -fx-text-fill: #c8d2e6;" />

                                <Button text="Supprimer"
                                        onAction="#confirmDelete"
                                        style="-fx-background-color: #ef4444;
                                               -fx-text-fill: white;
                                               -fx-background-radius: 20;" />
                            </HBox>

                        </VBox>
                    </children>
                </Pane>

            </children>
        </HBox>

    </children>
</Pane>
