<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane prefHeight="700.0" prefWidth="780.0"
            stylesheets="@style.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.AjouterReclamationController"
            style="-fx-background-color:#f8f4ef;">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16"
              style="-fx-background-color:linear-gradient(to right,#0f2a2a,#1a3a3a); -fx-padding:20 32;">
            <Button text="← Retour" onAction="#annuler"
                    style="-fx-background-color:rgba(255,255,255,0.15); -fx-text-fill:white; -fx-background-radius:20; -fx-padding:7 18; -fx-cursor:hand; -fx-font-weight:700;"/>
            <Label text="📝  NOUVELLE RÉCLAMATION"
                   style="-fx-text-fill:white; -fx-font-size:20px; -fx-font-weight:900;"/>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background-color:transparent; -fx-background:transparent; -fx-border-color:transparent;">
            <VBox alignment="TOP_CENTER" style="-fx-padding:40 0;">
                <VBox maxWidth="580" spacing="24"
                      style="-fx-background-color:white; -fx-background-radius:24; -fx-border-radius:24; -fx-border-color:#e6ddd0; -fx-border-width:1.5; -fx-padding:36 40; -fx-effect:dropshadow(gaussian,rgba(0,0,0,0.08),20,0,0,6);">

                    <VBox spacing="6">
                        <Label text="Déposer une réclamation 📋"
                               style="-fx-font-size:22px; -fx-font-weight:900; -fx-text-fill:#0f2a2a;"/>
                        <Label text="Nous prenons chaque réclamation très au sérieux"
                               style="-fx-font-size:13px; -fx-text-fill:#8a7a6a;"/>
                    </VBox>

                    <Separator style="-fx-background-color:#e6ddd0;"/>

                    <!-- Catégorie -->
                    <VBox spacing="8">
                        <Label text="CATÉGORIE"
                               style="-fx-font-size:11px; -fx-font-weight:800; -fx-text-fill:#6a7a73; -fx-letter-spacing:1;"/>
                        <ComboBox fx:id="comboCategorie"
                                  promptText="Choisir une catégorie"
                                  prefWidth="500" prefHeight="44"
                                  style="-fx-background-color:#fbf7f1; -fx-border-color:#d9cdbf; -fx-border-radius:12; -fx-background-radius:12; -fx-font-size:14px;"/>
                        <Label fx:id="errCategorie" text=""
                               style="-fx-text-fill:#e53e3e; -fx-font-size:11px; -fx-font-weight:700;"/>
                    </VBox>

                    <!-- Titre -->
                    <VBox spacing="8">
                        <Label text="TITRE"
                               style="-fx-font-size:11px; -fx-font-weight:800; -fx-text-fill:#6a7a73; -fx-letter-spacing:1;"/>
                        <TextField fx:id="txtTitre"
                                   promptText="Ex: Chambre non conforme aux photos"
                                   prefHeight="44"
                                   style="-fx-background-color:#fbf7f1; -fx-border-color:#d9cdbf; -fx-border-radius:12; -fx-background-radius:12; -fx-font-size:14px; -fx-padding:0 14;"/>
                        <Label fx:id="errTitre" text=""
                               style="-fx-text-fill:#e53e3e; -fx-font-size:11px; -fx-font-weight:700;"/>
                    </VBox>

                    <!-- Priorité -->
                    <VBox spacing="8">
                        <Label text="PRIORITÉ"
                               style="-fx-font-size:11px; -fx-font-weight:800; -fx-text-fill:#6a7a73; -fx-letter-spacing:1;"/>
                        <HBox spacing="10">
                            <Button fx:id="btnBasse"   text="🟢  Basse"   onAction="#selectPriorite" prefWidth="118" prefHeight="40"
                                    style="-fx-background-color:#f0fdf4; -fx-text-fill:#16a34a; -fx-border-color:#bbf7d0; -fx-border-width:1.5; -fx-border-radius:10; -fx-background-radius:10; -fx-font-weight:700; -fx-cursor:hand;"/>
                            <Button fx:id="btnMoyenne" text="🔵  Moyenne" onAction="#selectPriorite" prefWidth="118" prefHeight="40"
                                    style="-fx-background-color:#eff6ff; -fx-text-fill:#1d4ed8; -fx-border-color:#bfdbfe; -fx-border-width:1.5; -fx-border-radius:10; -fx-background-radius:10; -fx-font-weight:700; -fx-cursor:hand;"/>
                            <Button fx:id="btnHaute"   text="🟠  Haute"   onAction="#selectPriorite" prefWidth="118" prefHeight="40"
                                    style="-fx-background-color:#fff7ed; -fx-text-fill:#c2410c; -fx-border-color:#fed7aa; -fx-border-width:1.5; -fx-border-radius:10; -fx-background-radius:10; -fx-font-weight:700; -fx-cursor:hand;"/>
                            <Button fx:id="btnUrgente" text="🔴  Urgente" onAction="#selectPriorite" prefWidth="118" prefHeight="40"
                                    style="-fx-background-color:#fff1f2; -fx-text-fill:#be123c; -fx-border-color:#fecdd3; -fx-border-width:1.5; -fx-border-radius:10; -fx-background-radius:10; -fx-font-weight:700; -fx-cursor:hand;"/>
                        </HBox>
                        <Label fx:id="errPriorite" text=""
                               style="-fx-text-fill:#e53e3e; -fx-font-size:11px; -fx-font-weight:700;"/>
                    </VBox>

                    <!-- Description -->
                    <VBox spacing="8">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="DESCRIPTION"
                                   style="-fx-font-size:11px; -fx-font-weight:800; -fx-text-fill:#6a7a73; -fx-letter-spacing:1;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="lblCharCount" text="0 / 500"
                                   style="-fx-font-size:11px; -fx-text-fill:#b0a090;"/>
                        </HBox>
                        <TextArea fx:id="txtDescription"
                                  promptText="Décrivez votre problème en détail..."
                                  prefHeight="130" wrapText="true"
                                  style="-fx-background-color:#fbf7f1; -fx-border-color:#d9cdbf; -fx-border-radius:12; -fx-background-radius:12; -fx-font-size:14px; -fx-padding:12;"/>
                        <Label fx:id="errDescription" text=""
                               style="-fx-text-fill:#e53e3e; -fx-font-size:11px; -fx-font-weight:700;"/>
                    </VBox>

                    <Label fx:id="lblResultat" text="" wrapText="true"
                           style="-fx-font-size:13px;"/>

                    <HBox spacing="14" alignment="CENTER">
                        <Button text="📤  Envoyer la réclamation" onAction="#enregistrer"
                                prefWidth="230" prefHeight="46"
                                style="-fx-background-color:#c9a24a; -fx-text-fill:white; -fx-font-weight:800; -fx-font-size:14px; -fx-background-radius:23; -fx-cursor:hand; -fx-effect:dropshadow(gaussian,rgba(201,162,74,0.4),12,0,0,4);"/>
                        <Button text="✕  Annuler" onAction="#annuler"
                                prefWidth="140" prefHeight="46"
                                style="-fx-background-color:white; -fx-text-fill:#0f2a2a; -fx-font-weight:700; -fx-background-radius:23; -fx-border-color:#d9cdbf; -fx-border-width:1.5; -fx-cursor:hand;"/>
                    </HBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
